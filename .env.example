# ==============================================================================
# AML Entity Matching - Environment Configuration Example
# ==============================================================================
# Güvenlik Notu: Bu dosyayı '.env' olarak kopyalayın ve gerçek şifrelerle değiştirin.
# Gerçek '.env' dosyası asla git deposuna (GitHub, vb.) commit edilmemelidir (.gitignore ile korunur).
# ==============================================================================

# Database Connection Credentials
AML_DB_HOST=127.0.0.1
AML_DB_PORT=5433
AML_DB_NAME=aml_db
AML_DB_USER=postgres
AML_DB_PASSWORD=change_me

# Security & Audit Controls
AML_DB_SSLMODE=prefer
AML_ENABLE_AUDIT_TRAIL=true
AML_APPEND_ONLY_HISTORY=true
